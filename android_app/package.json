{
  "name": "divewatch",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "esbuild www/app.js --bundle --outfile=www/bundle.js --format=iife --target=es2020 --log-level=info",
    "sync": "npm run build && npx cap sync android",
    "open": "npx cap open android",
    "build-apk": "npm run sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor-community/bluetooth-le": "^7.0.0",
    "chart.js": "^4.4.4",
    "esbuild": "^0.24.0"
  }
}
